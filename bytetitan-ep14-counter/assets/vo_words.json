{
 "phrases": [
  {
   "scene": "hook",
   "text": "Breaking news!",
   "start": 0.12,
   "end": 0.938
  },
  {
   "scene": "hook",
   "text": "You're still counting items by hand in Python?",
   "start": 0.998,
   "end": 3.279
  },
  {
   "scene": "oldway",
   "text": "The old way?",
   "start": 3.4,
   "end": 4.215
  },
  {
   "scene": "oldway",
   "text": "Make an empty dictionary,",
   "start": 4.275,
   "end": 5.87
  },
  {
   "scene": "oldway",
   "text": "loop through every vote,",
   "start": 5.93,
   "end": 7.263
  },
  {
   "scene": "oldway",
   "text": "check if it's already there,",
   "start": 7.323,
   "end": 8.715
  },
  {
   "scene": "oldway",
   "text": "then add one.",
   "start": 8.775,
   "end": 9.742
  },
  {
   "scene": "oldway",
   "text": "Six lines for a simple count.",
   "start": 9.802,
   "end": 11.553
  },
  {
   "scene": "counter",
   "text": "Meet Counter,",
   "start": 13.4,
   "end": 14.297
  },
  {
   "scene": "counter",
   "text": "from the collections module.",
   "start": 14.357,
   "end": 15.845
  },
  {
   "scene": "counter",
   "text": "Hand it any list,",
   "start": 15.905,
   "end": 17.059
  },
  {
   "scene": "counter",
   "text": "and it counts everything in one line.",
   "start": 17.119,
   "end": 19.033
  },
  {
   "scene": "winner",
   "text": "Want the winner?",
   "start": 24.35,
   "end": 25.192
  },
  {
   "scene": "winner",
   "text": "Use most_common.",
   "start": 25.252,
   "end": 26.346
  },
  {
   "scene": "winner",
   "text": "Ask for the top one,",
   "start": 26.406,
   "end": 27.631
  },
  {
   "scene": "winner",
   "text": "or the top two.",
   "start": 27.691,
   "end": 28.623
  },
  {
   "scene": "winner",
   "text": "It returns them sorted,",
   "start": 28.683,
   "end": 30.064
  },
  {
   "scene": "winner",
   "text": "highest first.",
   "start": 30.124,
   "end": 31.113
  },
  {
   "scene": "strings",
   "text": "It's not just for votes.",
   "start": 36.35,
   "end": 37.755
  },
  {
   "scene": "strings",
   "text": "Pass it a string",
   "start": 37.815,
   "end": 38.86
  },
  {
   "scene": "strings",
   "text": "and it counts every letter.",
   "start": 38.92,
   "end": 40.302
  },
  {
   "scene": "strings",
   "text": "Perfect for word counts,",
   "start": 40.362,
   "end": 41.783
  },
  {
   "scene": "strings",
   "text": "anagram checks and more.",
   "start": 41.843,
   "end": 43.272
  },
  {
   "scene": "bonus",
   "text": "And the best part?",
   "start": 46.35,
   "end": 47.391
  },
  {
   "scene": "bonus",
   "text": "Ask for a missing item",
   "start": 47.45,
   "end": 48.765
  },
  {
   "scene": "bonus",
   "text": "and you get zero,",
   "start": 48.825,
   "end": 49.84
  },
  {
   "scene": "bonus",
   "text": "not a crash.",
   "start": 49.9,
   "end": 50.782
  },
  {
   "scene": "bonus",
   "text": "No KeyError,",
   "start": 50.842,
   "end": 51.779
  },
  {
   "scene": "bonus",
   "text": "no extra checks.",
   "start": 51.839,
   "end": 53.056
  },
  {
   "scene": "outro",
   "text": "Follow ByteTitan for more Python results.",
   "start": 54.3,
   "end": 56.355
  },
  {
   "scene": "outro",
   "text": "Next up\u2026",
   "start": 56.415,
   "end": 57.109
  },
  {
   "scene": "outro",
   "text": "is vs ==",
   "start": 57.169,
   "end": 58.493
  },
  {
   "scene": "outro",
   "text": "Stay tuned!",
   "start": 58.553,
   "end": 59.274
  }
